# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# intake / any media bytes — repos are text + links only (regenerate fixtures locally)
fixtures/intakes/.venv/
fixtures/intakes/.tmp_tts/
*.wav
*.mp3
*.m4a
*.ogg
*.flac
*.webm
!docs/**/*.md

# local ticket tips / media (Intake edge store) — never commit uploads
.data/
**/media/
**/.cache/
apps/android-testmode/ticket-detail-smoke.png

# Android compiler caches if a build is run outside apps/android-testmode
**/.gradle/
**/.kotlin/
**/.cxx/
**/.externalNativeBuild/
