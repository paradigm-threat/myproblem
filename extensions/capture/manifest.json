{
  "manifest_version": 3,
  "name": "Relay · MyProblem · v0.1.23",
  "version": "0.1.23",
  "description": "Relay gathers read-only updates from social groups you already visit. SI organizes topics; humans still send origin replies. Networkers keep help moving. Not a bot scraper.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Relay · MyProblem · v0.1.23",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "activeTab",
    "clipboardWrite",
    "scripting",
    "downloads",
    "declarativeContent"
  ],
  "host_permissions": [
    "https://nextdoor.com/*",
    "https://*.nextdoor.com/*",
    "https://*.nextdoor-media.com/*",
    "https://*.ndimg.com/*",
    "https://*.amazonaws.com/*",
    "https://*.cloudfront.net/*",
    "https://*.akamaized.net/*",
    "https://*.googleusercontent.com/*",
    "https://api.clevertree.chat/*",
    "https://myproblem.app/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://nextdoor.com/*", "https://*.nextdoor.com/*"],
      "js": ["lib/scrub.js", "lib/topics.js", "lib/external-id.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["data/*.json"],
      "matches": ["https://nextdoor.com/*", "https://*.nextdoor.com/*"]
    }
  ]
}
