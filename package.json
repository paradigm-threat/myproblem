{
  "name": "myproblem",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/generate-business-pdf.cjs",
    "generate:pdf": "node scripts/generate-business-pdf.cjs",
    "publish:demo-apk": "node scripts/publish-demo-apk.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:android": "cd apps/android-testmode && ./gradlew :app:testDebugUnitTest",
    "generate:intake-fixtures": "fixtures/intakes/.venv/bin/python fixtures/intakes/scripts/generate_intakes.py --tier easy,medium,hard",
    "test:intake-fixtures": "vitest run src/lib/intakeFixtures.test.ts src/lib/intakeFixtureScore.test.ts src/lib/realtimeIntakeStages.test.ts src/lib/photoAnalysis.test.ts",
    "test:fixture-asr": "node ../myproblem-tickets/workers/batch/drain-and-decommission.mjs fixtures"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/blob": "^2.8.2",
    "next": "16.4.5",
    "pdfkit": "^0.20.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
