REQUIRE_TICKET_CLAIM=

# Ops wake / Batch
OPS_WAKE_SECRET=
WAKE_ASR_MIN=1
WAKE_VISION_MIN=1
WAKE_PROJECT_MIN=1
GROQ_API_KEY=

# Bunny (Intake/Batch secrets only — never ship to APK or tip git)
